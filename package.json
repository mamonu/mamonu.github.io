{
  "name": "mamonu-presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "activity:update": "node scripts/update-github-activity.mjs",
    "test": "node --test",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "deploy": "vite build && gh-pages -d dist --nojekyll --repo https://github.com/mamonu/mamonu.github.io.git",
    "check:deploy": "vite build && node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "vite": "8.2.2"
  },
  "packageManager": "pnpm@10.30.3"
}
